# Copy this to .env on the VM — fill in every value, no defaults are safe for prod

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_DB=whatismybill
POSTGRES_USER=whatismybill
POSTGRES_PASSWORD=<strong-random-password>

# ── Backend ─────────────────────────────────────────────────────────────────
# 64+ random characters — generate with: openssl rand -hex 32
JWT_SECRET=<openssl-rand-hex-32>

# The public domain your frontend is served from (used for CORS)
FRONTEND_URL=https://whatismybill.today

# ── Frontend (baked into Next.js bundle at build time) ──────────────────────
# Must be the public URL the browser calls — via Caddy's /api route
NEXT_PUBLIC_API_URL=https://whatismybill.today/api
