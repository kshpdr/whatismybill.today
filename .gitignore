# env files — ignore real secrets, keep examples
.env
.env.local
.env.*.local
backend/.env
backend/data/

# Claude / Cursor workspace files
.claude/

# Firebase leftovers (Firebase was abandoned in favour of custom backend)
.firebaserc
firebase.json
firestore.indexes.json
firestore.rules
functions/
lib/firebase/
bills/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
test-bills/

# backend compiled output
backend/dist/
