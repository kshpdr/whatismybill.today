# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=whatismybill
POSTGRES_USER=whatismybill
POSTGRES_PASSWORD=change-me-strong-password

# ── Backend ───────────────────────────────────────────────────────────────────
# JWT_SECRET must be a long random string — generate with:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-char-random-string

# Telegram Login (optional). Token from @BotFather. Bind your domain in BotFather
# with /setdomain — the login widget only renders on that exact domain.
# Leave unset to disable Telegram login entirely.
TELEGRAM_BOT_TOKEN=

# ── Frontend (baked into the Next.js bundle at build time) ───────────────────
# In production: https://yourdomain.com/api
# In dev:        http://localhost:3001
NEXT_PUBLIC_API_URL=https://whatismybill.today/api

# Bot username (WITHOUT the @) for the Telegram login widget. Must match the bot
# whose TELEGRAM_BOT_TOKEN is set above. Leave unset to hide the login button.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# ── URLs (used by backend CORS) ───────────────────────────────────────────────
FRONTEND_URL=https://whatismybill.today
