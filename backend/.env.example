DATABASE_URL=postgresql://whatismybill:password@localhost:5432/whatismybill
JWT_SECRET=change-me-to-a-random-64-character-string
UPLOAD_DIR=./data/bills
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── Telegram bot (optional) ───────────────────────────────────────────────────
# Same bot token as the Login Widget (from @BotFather). Enables both Telegram
# login and the bill-upload bot. Leave unset to disable Telegram entirely.
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL Telegram POSTs updates to. In prod:
#   https://whatismybill.today/api/telegram/webhook
# Leave unset in local dev (the widget/bot won't work on localhost anyway).
TELEGRAM_WEBHOOK_URL=
# Shared secret echoed back by Telegram on every webhook call (recommended).
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
