{
  "name": "whatismybill-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import=tsx/esm --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "node --env-file=.env --import=tsx/esm src/db/migrate.ts",
    "generate": "drizzle-kit generate",
    "test:run": "vitest run",
    "test": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.7",
    "jose": "^5.10.0",
    "pdf-parse": "^2.0.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.3",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  }
}
